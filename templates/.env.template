# .env — copy to repo root as .env (never commit)
# Secrets only. All other settings go in config.yaml (see docs/standards/env_and_config.md).

### Temporal ###

# Temporal PostgreSQL password (auto-generated by deploy script if left as placeholder)
TEMPORAL_POSTGRES_PASSWORD="YOUR_SECURE_TEMPORAL_DB_PASSWORD_HERE"

### OpenVitals app (required; app DB will be deployed by Genesis workflow) ###

# OpenVitals PostgreSQL password only (user/db name/port go in config.yaml). Auto-generated by bootstrap if left as placeholder.
OPENVITALS_DB_PASSWORD="YOUR_SECURE_OPENVITALS_DB_PASSWORD_HERE"

### pgAdmin (dev-only; login password) ###

# pgAdmin 4 default admin password. Auto-generated by bootstrap if left as placeholder.
PGADMIN_DEFAULT_PASSWORD="YOUR_SECURE_PGADMIN_PASSWORD_HERE"
