# config.yaml — copy to repo root as config.yaml (never commit)
# Non-secret settings only. Secrets go in .env. See docs/standards/env_and_config.md.

# Deployment environment: dev | test | prod. Drives Temporal namespace and compose override.
temporal:
  deployment_env: dev

# Repo path; bootstrap sets this to the actual repo root when possible.
openvitals:
  project_root: ""  # set by bootstrap or set manually

